# FREE (recommended): get key at https://aistudio.google.com/apikey (no card)
AI_API_KEY=AIza-paste-free-key-here
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_MODEL=gemini-3-flash-preview
# Alt FREE Groq: AI_BASE_URL=https://api.groq.com/openai/v1 + AI_MODEL=llama-3.3-70b-versatile, key at https://console.groq.com
# Alt LOCAL no-key: AI_BASE_URL=http://localhost:11434/v1 + AI_MODEL=llama3.1 + AI_API_KEY=ollama (needs ollama installed)
# Password lock (required before exposing online): anyone opening the site must enter this
APP_PASSWORD=change-me-to-something-secret
# Saved keys per brain (the website ⚙️ Brain panel manages these, one per line):
# GEMINI_API_KEY=AIza... (free, https://aistudio.google.com/apikey)
# GROQ_API_KEY=gsk_... (free, https://console.groq.com)
# OPENAI_API_KEY=sk-... (paid, https://platform.openai.com)
# MODEL_API_KEY=LLM|... (paid Muse Spark, https://ai.developer.meta.com)
# XAI_API_KEY=xai-... (paid Grok / Elon Musk AI, https://console.x.ai)
# MIMO_API_KEY=sk-... (pay-per-use Xiaomi MiMo, https://platform.xiaomimimo.com/console/api-keys)
# GITHUB_TOKEN=ghp_... (free GPT-4o mini quotas, https://github.com/settings/tokens)
# OPENROUTER_API_KEY=sk-or-... (free models, https://openrouter.ai/keys)
# No key needed: Pollinations (online free, no signup), Ollama (offline)
